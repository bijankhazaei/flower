{
  "name": "default-agent",
  "version": "1.0.0",
  "description": "Default agent configuration",
  "mcpServers": {
    "flower-task-manager": {
      "command": "python",
      "disabled": false,
      "timeout": 60000,
      "args": [
        "/Users/s.khazaei/Projects/flower/mcp/task_server.py"
      ]
    }
  },
  "tools": [
    "fsRead",
    "fsWrite",
    "fsReplace",
    "listDirectory",
    "fileSearch",
    "executeBash",
    "@flower-task-manager"
  ],
  "allowedTools": [
    "fsRead",
    "fsWrite",
    "fsReplace",
    "listDirectory",
    "fileSearch",
    "@flower-task-manager/create_task",
    "@flower-task-manager/list_tasks",
    "@flower-task-manager/update_task"
  ],
  "toolsSettings": {
    "execute_bash": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    },
    "use_aws": {
      "alwaysAllow": [
        {
          "preset": "readOnly"
        }
      ]
    }
  },
  "includedFiles": [],
  "resources": []
